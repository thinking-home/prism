<?xml version="1.0" encoding="utf-8"?>
<!-- Манифест — «паспорт» приложения: что за приложение и из чего состоит. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Разрешение выходить в сеть (иначе видео не загрузить). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Prism Player"
        android:usesCleartextTraffic="true"><!-- разрешить http:// (Prism без https) -->

        <!-- Единственный экран приложения. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- Этот intent-filter делает экран точкой входа и кладёт иконку в меню приложений. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
