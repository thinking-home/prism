<?xml version="1.0" encoding="utf-8"?>
<!-- Манифест — «паспорт» приложения: что за приложение и из чего состоит. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Разрешение выходить в сеть (иначе видео не загрузить). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Разрешения для фонового сервиса воспроизведения и его уведомления. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Запуск службы после перезагрузки устройства. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- «Поверх других приложений» — чтобы вывести видео на экран из фона по команде. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:label="Prism Player"
        android:usesCleartextTraffic="true"><!-- разрешить http:// (Prism без https) -->

        <!-- Единственный экран приложения. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- Этот intent-filter делает экран точкой входа и кладёт иконку в меню приложений. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Фоновый сервис с медиа-сессией. intent-filter делает его доступным
             для системных медиа-контроллеров; foregroundServiceType — тип «воспроизведение». -->
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Всегда-живая служба MQTT (со своим постоянным уведомлением). -->
        <service
            android:name=".MqttService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Приёмник события «система загрузилась» — стартует службу после перезагрузки. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
