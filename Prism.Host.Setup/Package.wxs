<!-- Инсталлятор Prism Host: ставит службу (Prism.Host.Service) в Program Files,
     регистрирует её в Windows (автостарт, LocalSystem) и открывает входящие
     подключения в брандмауэре для локальной сети. Всё декларативно, кастомных
     действий нет. Файлы берутся из publish-выхода проектов — bindpath'ы
     !(bindpath.*) создаёт ProjectReference Publish="true" в .wixproj. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

    <!-- Инсталлятор не локализован (en-US по умолчанию): видимые пользователю
         строки — английские, это избавляет от возни с культурами и переводом
         строк расширений. -->
    <Package Name="Prism Host"
             Manufacturer="Prism"
             Version="0.3.0"
             UpgradeCode="8360D512-7A9E-4DA9-8645-BD7E5D061883"
             Scope="perMachine">

        <MajorUpgrade DowngradeErrorMessage="A newer version of Prism Host is already installed." />
        <MediaTemplate EmbedCab="yes" />

        <!-- UI: стандартный набор диалогов WixUI_InstallDir, где диалог выбора
             папки перенацелен на MEDIAFOLDER — куда ставить саму программу,
             пользователю выбирать незачем. На шаге лицензии показывается
             License.rtf (MIT + сведения о вложенной сборке FFmpeg). -->
        <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="MEDIAFOLDER" />
        <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

        <!-- «Запоминание» выбранной папки (стандартный remember-паттерн):
             при установке путь пишется в реестр (компонент MediaFolderReg ниже),
             при обновлении — вычитывается обратно, если не задан явно
             (msiexec ... MEDIAFOLDER=D:\Video). -->
        <Property Id="MEDIAFOLDER" Secure="yes" />
        <Property Id="PRISM_SAVED_MEDIAFOLDER">
            <RegistrySearch Id="SavedMediaFolder" Root="HKLM" Key="SOFTWARE\Prism\Host" Name="MediaFolder" Type="raw" />
        </Property>
        <SetProperty Id="MEDIAFOLDER" Value="[PRISM_SAVED_MEDIAFOLDER]" After="AppSearch"
                     Condition="NOT MEDIAFOLDER AND PRISM_SAVED_MEDIAFOLDER" />

        <!-- Папка по умолчанию: <корневой диск>\Videos (меняется в диалоге). -->
        <StandardDirectory Id="TARGETDIR">
            <Directory Id="MEDIAFOLDER" Name="Videos" />
        </StandardDirectory>

        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="INSTALLFOLDER" Name="Prism Host">

                <!-- Служба публикуется одним exe (self-contained, PublishSingleFile),
                     поэтому служба и её бинарь — один явный компонент. -->
                <Component Id="HostService">
                    <File Id="PrismHostExe" Source="!(bindpath.Prism.Host.Service)\Prism.Host.Service.exe" KeyPath="yes">
                        <!-- Плееры (Android TV) ходят на Kestrel из локальной сети. -->
                        <fw:FirewallException Id="PrismHostLan"
                                              Name="Prism Host"
                                              Description="Prism Host - HTTP (HLS) video streaming."
                                              Scope="localSubnet"
                                              Profile="all" />
                    </File>
                    <!-- Выбранная папка с видео уходит службе штатным аргументом
                         «media» командной строки (хост его уже умеет). Хвостовой
                         '\' перед закрывающей кавычкой — экранирование:
                         [MEDIAFOLDER] заканчивается на '\', и без добавочного
                         он «съел» бы кавычку при разборе командной строки. -->
                    <ServiceInstall Id="PrismHostService"
                                    Name="PrismHost"
                                    DisplayName="Prism Host"
                                    Description="Prism media server: streams video from a local folder over HTTP (HLS)."
                                    Type="ownProcess"
                                    Start="auto"
                                    Account="LocalSystem"
                                    ErrorControl="normal"
                                    Arguments="--media &quot;[MEDIAFOLDER]\&quot;" />
                    <ServiceControl Id="PrismHostControl"
                                    Name="PrismHost"
                                    Start="install"
                                    Stop="both"
                                    Remove="uninstall"
                                    Wait="yes" />
                </Component>

                <Component Id="AppSettings">
                    <File Source="!(bindpath.Prism.Host.Service)\appsettings.json" />
                </Component>

                <!-- Путь к папке с видео в реестре: отсюда его вычитывает
                     обновление (remember-паттерн выше), позже — интеграция
                     с проводником. -->
                <Component Id="MediaFolderReg">
                    <RegistryValue Root="HKLM" Key="SOFTWARE\Prism\Host"
                                   Name="MediaFolder" Type="string"
                                   Value="[MEDIAFOLDER]" KeyPath="yes" />
                </Component>

                <!-- Вложенная сборка ffmpeg (см. FetchFFmpeg в .wixproj):
                     FFTools ищет её рядом с приложением, в PATH ничего
                     прописывать не нужно. -->
                <Directory Id="FFmpegInstallDir" Name="ffmpeg">
                    <Component Id="FFmpegExe">
                        <File Source="$(FFmpegBin)\ffmpeg.exe" />
                    </Component>
                    <Component Id="FFprobeExe">
                        <File Source="$(FFmpegBin)\ffprobe.exe" />
                    </Component>
                </Directory>

                <!-- Плагины — как в дев-раскладке: plugins/<имя>/… ; содержимое
                     папки публикации плагина собирается по маске при сборке MSI. -->
                <Directory Id="PluginsDir" Name="plugins">
                    <Directory Id="LibraryPluginDir" Name="Prism.Plugins.Library">
                        <Files Include="!(bindpath.Prism.Plugins.Library)\**" />
                    </Directory>
                </Directory>

                <!-- Лаунчер (значок в трее + пункт «Отправить» проводника).
                     В своей подпапке, потому что у него собственный
                     appsettings.json — имя совпадает с конфигом хоста. -->
                <Directory Id="LauncherDir" Name="launcher">
                    <Component Id="LauncherExe">
                        <File Id="PrismLauncherExe" Source="!(bindpath.Prism.Launcher)\Prism.Launcher.exe" KeyPath="yes" />
                        <!-- Автозапуск при входе в систему. Пункт «Отправить»
                             лаунчер создаёт себе сам при первом запуске: папка
                             SendTo — в профиле пользователя, а установка
                             машинная (см. ShellIntegration). -->
                        <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                                       Name="PrismLauncher" Type="string"
                                       Value="&quot;[LauncherDir]Prism.Launcher.exe&quot;" />
                    </Component>
                    <!-- Конфиг берём из исходников проекта, а не из publish-выхода:
                         это статический файл, а инкрементальная публикация его
                         иногда не докладывает (exe свежий, конфига нет). -->
                    <Component Id="LauncherSettings">
                        <File Id="LauncherAppSettings" Source="..\Prism.Launcher\appsettings.json" />
                    </Component>
                </Directory>

            </Directory>
        </StandardDirectory>

    </Package>
</Wix>
