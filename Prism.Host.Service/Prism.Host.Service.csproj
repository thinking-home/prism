<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- Служба Windows (ставится инсталлятором Prism.Host.Setup). Публикуется
         одним self-contained exe — .NET на целевой машине не нужен. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <InvariantGlobalization>true</InvariantGlobalization>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Prism.Host\Prism.Host.csproj" />
    </ItemGroup>

</Project>
