{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      }
    }
  },
  "Plugins": [ "Prism.Plugins.Library" ],
  "Database": {
    "Provider": "sqlite",
    "ConnectionString": "Data Source=data/prism.db"
  },
  "Player": {
    "MediaDirectory": "videos"
  }
}
