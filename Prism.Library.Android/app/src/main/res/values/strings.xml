<?xml version="1.0" encoding="utf-8"?>
<!-- Строки по умолчанию (английский). Русские — в values-ru/strings.xml.
     Язык выбирается автоматически по языку системы. -->
<resources>
    <string name="settings_library_url">Prism library address</string>
    <string name="settings_save">Save</string>
    <string name="settings_url_required">Enter the library address</string>
    <string name="library_loading">Loading library…</string>
    <string name="library_error">Error: %1$s</string>
    <string name="library_empty">This folder is empty</string>
    <string name="library_root_title">Library root</string>
    <!-- Показывается вместо обычного названия файла, если он сейчас
         недоступен ни на одном хосте (present:false). -->
    <string name="library_file_unavailable">%1$s (unavailable)</string>

    <!-- Шторка «информация о файле» (шаг 6). -->
    <string name="media_info_loading">Loading file info…</string>
    <string name="media_info_unavailable">This file is not available on any host right now</string>
    <string name="media_info_duration">Duration: %1$s</string>
